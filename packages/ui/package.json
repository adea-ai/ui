{
  "name": "@adea-ai/ui",
  "version": "0.61.1",
  "description": "The Adea design system: Kobalte-backed Solid components, semantic OKLCH tokens, and the app-shell layout primitives shared by Adea and Cortana.",
  "keywords": [
    "adea",
    "components",
    "design-system",
    "kobalte",
    "shadcn",
    "solid",
    "solidjs",
    "tailwind"
  ],
  "homepage": "https://github.com/adea-ai/ui#readme",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.stories.ts",
    "!src/**/*.mdx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__screenshots__",
    "registry.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "solid": "./src/components/*/index.ts",
      "development": "./src/components/*/index.ts",
      "import": "./dist/components/*/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "solid": "./src/lib/*.ts",
      "development": "./src/lib/*.ts",
      "import": "./dist/lib/*.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./base.css": "./src/styles/base.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite build --watch",
    "lint": "oxlint",
    "test": "bun test --conditions=browser tests",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "registry:build": "bun scripts/build-registry.ts",
    "registry:validate": "bun scripts/validate-registry.ts",
    "pack:check": "bun scripts/check-pack.ts",
    "check:tree-shaking": "bun scripts/check-tree-shaking.ts",
    "theme:build": "bun scripts/build-default-theme.ts",
    "theme:check": "bun scripts/build-default-theme.ts --check",
    "check:packed-consumer": "bun scripts/check-packed-consumer.ts",
    "check:packed-conversation": "bun scripts/check-packed-conversation.ts"
  },
  "dependencies": {
    "@adea-ai/themes": "^0.5.0",
    "@corvu/calendar": "^0.1.2",
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.2.0",
    "lucide-solid": "^1.48.0",
    "solid-motionone": "^1.0.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.0",
    "chart.js": "^4.5.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.15",
    "storybook": "^10.6.0",
    "storybook-solidjs-vite": "^10.7.2",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "chart.js": "^4.5.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    },
    "embla-carousel": {
      "optional": true
    },
    "embla-carousel-solid": {
      "optional": true
    },
    "solid-chartjs": {
      "optional": true
    }
  }
}
