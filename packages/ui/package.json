{
  "name": "@adea-ai/ui",
  "version": "0.112.0",
  "description": "The Adea design system: Kobalte-backed Solid components, semantic OKLCH tokens, and the app-shell layout primitives shared by Adea and Cortana.",
  "keywords": [
    "adea",
    "components",
    "design-system",
    "kobalte",
    "shadcn",
    "solid",
    "solidjs",
    "tailwind"
  ],
  "homepage": "https://github.com/adea-ai/ui#readme",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adea-ai/ui.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.css",
    "!src/**/*.mdx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__screenshots__",
    "registry.json",
    "README.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "imports": {
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./src/index.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "solid": "./src/components/*/index.ts",
      "development": "./src/components/*/index.ts",
      "import": "./dist/components/*/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "solid": "./src/lib/*.ts",
      "development": "./src/lib/*.ts",
      "import": "./dist/lib/*.js"
    },
    "./lib/cn-tables.generated": null,
    "./lint": {
      "types": "./dist/lint/index.d.ts",
      "default": "./dist/lint.js"
    },
    "./globals.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./base.css": "./src/styles/base.css",
    "./appearance-font-settings.css": "./src/styles/appearance-font-settings.css",
    "./fonts.css": "./src/styles/fonts.css",
    "./registry.json": "./registry.json",
    "./package.json": "./package.json",
    "./components/layout/split-layout/model": {
      "types": "./dist/components/layout/split-layout/model.d.ts",
      "solid": "./src/components/layout/split-layout/model.ts",
      "development": "./src/components/layout/split-layout/model.ts",
      "import": "./dist/components/layout/split-layout/model.js"
    },
    "./components/conversation/paste-tokens": {
      "types": "./dist/components/conversation/paste-tokens.d.ts",
      "solid": "./src/components/conversation/paste-tokens.ts",
      "development": "./src/components/conversation/paste-tokens.ts",
      "import": "./dist/components/conversation/paste-tokens.js"
    },
    "./components/conversation/transcript-composition": {
      "types": "./dist/components/conversation/transcript-composition.d.ts",
      "solid": "./src/components/conversation/transcript-composition.tsx",
      "development": "./src/components/conversation/transcript-composition.tsx",
      "import": "./dist/components/conversation/transcript-composition.js"
    },
    "./components/layout/split-layout/tree": {
      "types": "./dist/components/layout/split-layout/tree.d.ts",
      "solid": "./src/components/layout/split-layout/tree.ts",
      "development": "./src/components/layout/split-layout/tree.ts",
      "import": "./dist/components/layout/split-layout/tree.js"
    }
  },
  "scripts": {
    "build": "bun run cn:build && vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "bun run cn:build && vite build --watch",
    "lint": "oxlint",
    "test": "bun run cn:check && bun test --conditions=browser tests",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "cn:build": "bun scripts/build-cn-tables.ts",
    "cn:check": "bun scripts/check-cn-tables.ts",
    "registry:build": "bun run cn:build && bun scripts/build-registry.ts",
    "registry:validate": "bun run cn:check && bun scripts/validate-registry.ts",
    "pack:check": "bun scripts/check-pack.ts",
    "check:tree-shaking": "bun scripts/check-tree-shaking.ts",
    "theme:build": "bun scripts/build-default-theme.ts",
    "theme:check": "bun scripts/build-default-theme.ts --check",
    "design-system:build": "bun scripts/design-system/build.ts",
    "check:packed-layout": "node --test scripts/check-packed-layout-process.test.mjs && node scripts/check-packed-layout.mjs && node scripts/check-packed-layout-tree.mjs",
    "check:packed-lint": "node scripts/check-packed-lint.mjs",
    "check:packed-consumer": "bun scripts/check-packed-consumer.ts",
    "check:packed-list-row": "bun scripts/check-packed-list-row.ts",
    "check:packed-scene-controls": "bun scripts/check-packed-scene-controls.ts",
    "check:packed-conversation": "bun scripts/check-packed-conversation.ts",
    "check:packed-transcript": "bun scripts/check-packed-transcript.ts",
    "check:packed-layout-renderer": "bun scripts/check-packed-layout-renderer.ts",
    "check:packed-appearance": "bun scripts/check-packed-appearance.ts",
    "check:packed-modal-dialog": "bun scripts/check-packed-modal-dialog.ts",
    "check:packed-native-select": "bun scripts/check-packed-native-select.ts",
    "check:packed-settings-navigation": "bun scripts/check-packed-settings-navigation.ts",
    "check:packed-tree": "bun scripts/check-packed-tree.ts",
    "check:packed-paste-model": "node scripts/check-packed-paste-model.mjs"
  },
  "dependencies": {
    "@adea-ai/themes": "^0.9.7",
    "@corvu/calendar": "^0.1.2",
    "@corvu/drawer": "^0.2.4",
    "@corvu/otp-field": "^0.1.4",
    "@corvu/resizable": "^0.2.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@kobalte/core": "^0.13.14",
    "class-variance-authority": "^0.7.1",
    "cmdk-solid": "^1.2.0",
    "cn": "^0.4.0",
    "lucide-solid": "^1.51.0",
    "solid-motionone": "^1.0.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.1",
    "chart.js": "^4.5.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.15",
    "storybook": "^10.6.1",
    "storybook-solidjs-vite": "^10.7.2",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "chart.js": "^4.5.1",
    "embla-carousel": "^8.6.0",
    "embla-carousel-solid": "^8.6.0",
    "solid-chartjs": "^1.3.11",
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    },
    "embla-carousel": {
      "optional": true
    },
    "embla-carousel-solid": {
      "optional": true
    },
    "solid-chartjs": {
      "optional": true
    }
  }
}
