{
  "name": "@adea-ai/storybook",
  "version": "0.1.0",
  "private": true,
  "description": "The Adea design system workshop: every component, every variant, and the token galleries.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "dev": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build": "storybook build -o storybook-static",
    "lint": "oxlint",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.layout.json && bun check -p tsconfig.components.json",
    "serve": "bun scripts/serve-workshop.ts",
    "test": "bun test tests/unit",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.ts",
    "test:interactions": "playwright test tests/interactions.spec.ts",
    "test:layout": "playwright test --config=playwright.layout.config.ts",
    "test:components": "playwright test --config=playwright.components.config.ts",
    "test:design-system": "playwright test --config=playwright.design-system.config.ts",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "@adea-ai/themes": "^0.10.10",
    "@adea-ai/ui": "workspace:*",
    "lucide-solid": "^1.48.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-links": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/runner": "^4",
    "jsdom": "^30.1.1",
    "storybook": "10.6.2",
    "storybook-solidjs-vite": "^10.7.2",
    "tailwindcss": "^4.3.3",
    "typescript6": "npm:typescript@^6.0.3",
    "vite": "^8.3.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "5.0.5"
  }
}
